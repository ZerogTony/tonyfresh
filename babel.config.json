{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "browsers": ">0.25%, not dead"
        },
        "modules": false
      }
    ],
    [
      "@babel/preset-react",
      {
        "runtime": "automatic"
      }
    ]
  ],
  "env": {
    "production": {
      "plugins": [
        ["transform-remove-console", {
          "exclude": ["error", "warn"]
        }]
      ]
    }
  }
}
