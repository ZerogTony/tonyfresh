doctype html
html(lang="en")
  head
    include ./partials/head

  body
    include ./partials/navigation

    // Canvas background (solid color behind everything)
    .canvas__background

    // Global overlay for page transitions
    .global-overlay
      .global-overlay__row.global-overlay__row--top
      .global-overlay__row.global-overlay__row--bottom

    // White card for home page (sits between canvas and home content)
    .home__card

    // Overlay beams to hide content outside the card
    .home__card__beam--top
    .home__card__beam--bottom

    include ./partials/intro
    include ./partials/home
    include ./partials/about
    include ./partials/case

    include ./partials/noscript
    include ./partials/analytics
